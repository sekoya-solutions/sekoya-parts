# Variables the app reads. Copy to .env.local (git-ignored) and fill in locally;
# on Vercel they are set as sensitive environment variables. Never commit values.

# Neon connection strings (docs/adr/0005-database.md): pooled for the site,
# direct (unpooled) for migrations and bulk loads.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Payload's secret for signing admin sessions: a long random string
# (docs/adr/0006-content-management.md).
PAYLOAD_SECRET=

# Local only: the "Agent checks" secret of Vercel's Protection Bypass for
# Automation, sent as the x-vercel-protection-bypass header to read protected
# previews. Never put it in a URL. The app does not read it.
VERCEL_AUTOMATION_BYPASS_SECRET=

# The automation user's Payload API key (issue #55): 64 random hexadecimal
# characters, at least 32. Set it as a sensitive variable in Vercel's Preview
# environment only, where preview builds create the user, and locally so
# agents can call the preview's API. Never in Production.
AUTOMATION_API_KEY=

# The catalog the database tests expect (tests/payload-readback.test.ts): the
# scale and seed `npm run generate` loaded. Neon's branches hold the full
# catalog since issue #77; CI sets its own, small, in its workflow.
CATALOG_SCALE=full
CATALOG_SEED=1

# DeepL's API key, ending in ":fx" on the free plan (issue #104). Set as a
# sensitive variable in Vercel's Production environment only, never Preview,
# and as a GitHub Actions secret for the live check. Locally, the owner's
# key for the real run. The free plan allows 1,000,000 characters in total.
DEEPL_API_KEY=

# The daily cron's secret (vercel.json): Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" to /api/translations/run. A long random
# string, set as a sensitive variable in Vercel's Production environment only.
CRON_SECRET=
