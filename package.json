{
  "name": "sekoya-parts",
  "version": "0.0.0",
  "private": true,
  "description": "Spare-parts catalog, a portfolio project showing the feasibility of a very large catalog.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "markdownlint": "0.42.1",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "13.6.0",
    "markdownlint-cli2": "0.24.0",
    "pg": "8.20.0",
    "pg-copy-streams": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "lint:md": "markdownlint-cli2",
    "dev": "next dev",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "node scripts/payload.js",
    "generate": "node --env-file-if-exists=.env.local scripts/generate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
