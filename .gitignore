# Chat history: local only, prompts can contain secrets (only the README is committed)
docs/chat-history/*
!docs/chat-history/README.md

# Portable tools, downloaded locally
.tools/

# Dependencies and the Next.js build output
/node_modules/
/.next/

# Files Next.js and TypeScript regenerate on each build or type check
/next-env.d.ts
*.tsbuildinfo

# Environment files can hold secrets; only an example file may be committed
.env
.env.*
!.env.example

# Personal Claude Code settings for this repository
.claude/settings.local.json

# Operating system files
Thumbs.db
desktop.ini
.DS_Store
