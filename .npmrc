# Supply-chain settings, decided in docs/adr/0003-toolchain.md.
# No dependency runs code at install. A package that needs its install script
# is reviewed and run on purpose, with the reason written down.
# This also skips this package's own pre- and post- scripts.
ignore-scripts=true
# Only versions published at least three days ago are installed. A security
# release that must go in sooner is listed in min-release-age-exclude.
min-release-age=3
# Dependencies are saved at exact versions.
save-exact=true
